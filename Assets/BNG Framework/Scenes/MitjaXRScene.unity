  m_GameObject: {fileID: 1347489243}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d68bb58b5a29b0948b4031bf674c22e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BoomBlocks.BoomTutorial
  Launcher: {fileID: 756214651}
  ScoreManager: {fileID: 509662437}
  ShowEveryTime: 1
  CompletedKey: BoomBlocks.TutorialCompleted
  Hud: {fileID: 443283861}
  PickUpText:
    Title: Pick up the launcher
    Body: 'Reach for the launcher''s handle on the table and press <b>Grip</b> once.


      It
      stays in your hand until you press Grip again.'
  LoadText:
    Title: Load a ball
    Body: 'With your other hand, grab a <b>dark ball</b> from the left tray and push
      it into the <b>muzzle</b>.


      A ball appears at the end of the barrel
      when it is loaded.'
  ShootText:
    Title: Aim and fire
    Body: 'Hold the blue <b>foregrip</b> under the barrel with your other hand. The
      launcher steadies and shows the <b>aim line</b>.


      Aim a little above
      the target and pull the <b>Trigger</b>.'
  ExplosivesText:
    Title: Explosives & combos
    Body: '<color=#FF5A45><b>Red balls</b></color> explode on impact. <color=#FF5A45><b>TNT
      barrels</b></color> blow up when hit by a ball or a falling pillar.


      Scoring
      in quick succession raises your <b>combo multiplier</b>. Chain reactions pay
      off!'
  DoneText:
    Title: You're ready!
    Body: 'Ammo and targets have been reset.


      Score as many points as you
      can before you run out of ammo. Good luck!'
  StepCounterFormat: STEP {0} / {1}
  StepCounterDoneText: TUTORIAL
  FeedbackMessage: Nice!
  SkipMessage: Hold to skip tutorial
